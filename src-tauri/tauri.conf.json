{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Research Dome",
  "version": "1.0.0",
  "identifier": "com.researchdome.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Research Dome",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "backgroundColor": "#081523"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:*; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; worker-src 'self' blob:; frame-src 'self' http://127.0.0.1:* blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Research Dome",
    "copyright": "Copyright © 2026 Research Dome",
    "category": "Productivity",
    "shortDescription": "Local-first research paper workspace",
    "longDescription": "Research Dome keeps your research papers, highlighted sentences, cropped figures and LaTeX drafts together in one desktop workspace. Everything is stored on your own computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": { "depends": [] },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
